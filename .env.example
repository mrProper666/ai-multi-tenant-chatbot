# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ngo_chatbot

# Optional: use an elevated/admin DB user for migrations (ALTER TABLE requires ownership)
DATABASE_MIGRATION_URL=

# Vercel AI Gateway
# - On Vercel Preview/Production, AI Gateway can authenticate via OIDC automatically.
# - For local dev (without `vercel dev`), set an API key:
AI_GATEWAY_API_KEY=

# S3-Compatible Storage
S3_ENDPOINT=your_s3_endpoint
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=ngo-chatbot-documents

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant Resolution (TODO: implement proper tenant resolution)
# For now, tenantId can be passed via header or query param
TENANT_HEADER_NAME=X-Tenant-Id
